# ZOOKA-AI self-hosting configuration.
# Copy to .env.selfhost next to docker-compose.yml, then fill the required values.
# Nothing here requires a paid provider; every default points at software you run.

# ---- required ---------------------------------------------------------------
# Database password. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
# Signing secret for sessions. Generate: openssl rand -base64 32
AUTH_SECRET=

# ---- identity ---------------------------------------------------------------
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# ---- database (replaceable: PostgreSQL anywhere) ----------------------------
# compose builds DATABASE_URL from the POSTGRES_* values above.
# To use an external database instead, set DATABASE_URL yourself and remove the
# postgres service:
# DATABASE_URL=postgres://user:pass@host:5432/zooka?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_SSL=prefer
# Optional: run tenant-scoped queries under a restricted role. Requires the role and RLS
# migrations to have been applied (they are, in pending/).
# DATABASE_URL_TENANT=postgres://zooka_runtime:PASSWORD@host:5432/zooka
# TENANT_RLS_ENABLED=on

# ---- worker and scheduler ---------------------------------------------------
# Per-process concurrency. Set to the cores you own; there is no app-level ceiling.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=120000
WORKER_SHUTDOWN_GRACE_MS=20000

SCHEDULER_INTERVAL_MS=30000
# Batch size per pass, and the caps the scheduler respects when choosing work.
SCHEDULER_BATCH_SIZE=10
SCHEDULER_GLOBAL_LIMIT=10
SCHEDULER_PER_ORG_LIMIT=5
# Tool the scheduler hands to an execution when a task does not name one.
SCHEDULER_TOOL=github_repo_inspect

# ---- storage (replaceable: local disk, MinIO, any S3-compatible) ------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/storage
# For s3: STORAGE_DRIVER=s3 and enable the object-storage profile
# S3_BUCKET=zooka
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---- models (replaceable: gateway, openai-compatible, ollama, anthropic, google)
MODEL_PROVIDER=openai-compatible
MODEL_ID=
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=
MODEL_TIMEOUT_MS=60000

# ---- monitoring -------------------------------------------------------------
# Alerts are derived from execution health but delivered only when this is set.
# Any endpoint that accepts JSON: n8n webhook, Slack incoming webhook, Gotify, Uptime Kuma.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=60
