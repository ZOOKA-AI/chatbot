# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway 
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****
# Optional local fallback. When used, all selected chat models route to Gemini.
GEMINI_API_KEY=

# Guest paywall: when "true", anonymous visitors can try the chat with a
# 3-message limit before being asked to sign up / upgrade. Default (empty/false)
# keeps the site locked: unauthenticated users are redirected to /login.
GUEST_PAYWALL_ENABLED=

# Public site origin (https://zooka-ai.com in production); used for Stripe success/cancel/return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
POSTGRES_URL=****

# Stripe subscription billing (set Price IDs from Stripe; never use lookup keys as values)
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint https://zooka-ai.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# USD 19/month; Stripe Price lookup_key: zooka_pro_monthly
STRIPE_PRICE_PRO=
# USD 49/month; Stripe Price lookup_key: zooka_business_monthly
STRIPE_PRICE_BUSINESS=

# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Optional server-side web search provider
# Web search tools are enabled only when this key is configured.
TAVILY_API_KEY=

# Optional Google Drive read-only OAuth connector. Configure the Google Cloud
# OAuth consent screen and Drive API, then add this exact callback URI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
# Generate with: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Optional sanitized error reporting; no user content or PII is sent
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
