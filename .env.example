# =============================================================================
# ZOOKA-AI — complete environment reference
# Generated from every `process.env.*` read in lib/ app/ components/ (74 vars)
# plus the OAuth variables resolved dynamically by
# lib/integrations/oauth/config.ts (<PROVIDER>_CLIENT_ID / _CLIENT_SECRET).
#
# Rule: a feature is "integrated" only when its block below has real values.
# Copy to .env.local for development; set the same names in Vercel for
# Production (and Preview when you want preview builds to work like prod).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core runtime (required for the app to boot)
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployment, e.g. https://zooka-ai.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical auth URL (must match the domain people sign in on)
AUTH_URL=http://localhost:3000
# Custom domain used for workspace subdomains
PLATFORM_DOMAIN=zooka-ai.com
# NextAuth / auth.js signing secret (openssl rand -base64 32)
AUTH_SECRET=
# Legacy alias still read by some auth paths
NEXTAUTH_SECRET=
# Support inbox shown in the UI
NEXT_PUBLIC_SUPPORT_EMAIL=support@zooka-ai.com
# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# 2. Database (Supabase Postgres via Drizzle)
#    DATABASE_URL wins over POSTGRES_URL in lib/db/* and drizzle.config.ts.
#    Use the Transaction pooler for serverless: port 6543 + pgbouncer.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# One-off admin endpoints: /api/admin/migrate (x-migration-token), /api/admin/backup
MIGRATION_TOKEN=
BACKUP_TOKEN=
# Comma-separated list of admin emails
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# 3. Sign-in providers
# -----------------------------------------------------------------------------
# Google sign-in (console.cloud.google.com > Credentials)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Microsoft / Entra ID sign-in
MICROSOFT_LOGIN_CLIENT_ID=
MICROSOFT_LOGIN_CLIENT_SECRET=
# Facebook sign-in
FACEBOOK_LOGIN_CLIENT_ID=
FACEBOOK_LOGIN_CLIENT_SECRET=
# Phone / OTP sign-in
OTP_HASH_SECRET=

# -----------------------------------------------------------------------------
# 4. Google Workspace integrations (Drive / Gmail / Calendar)
#    Tokens are AES-256-GCM encrypted at rest with the key below.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# Shared envelope key for every stored integration credential
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 5. GitHub and Vercel integration (OAuth, names are built dynamically)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=
# Server-side Vercel API access for deploy/domain actions
VERCEL_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
# Injected automatically by Vercel at build time
VERCEL=1
VERCEL_URL=

# -----------------------------------------------------------------------------
# 6. WhatsApp Business Cloud API
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# 7. Meta / Instagram publishing
# -----------------------------------------------------------------------------
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 8. n8n automation bridge
# -----------------------------------------------------------------------------
N8N_WEBHOOK_SECRET=
N8N_WHATSAPP_FORWARD_URL=

# -----------------------------------------------------------------------------
# 9. Stripe billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# -----------------------------------------------------------------------------
# 10. AI models and research
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-2.0-flash
AI_GATEWAY_API_KEY=
TAVILY_API_KEY=
# Base44 agent bridge
BASE44_AGENT_APP_ID=
BASE44_AGENT_API_KEY=
BASE44_AGENT_ALLOW_ALL=false
BASE44_API_BASE=https://app.base44.com/api
SOLAS_AGENT_KEY=

# -----------------------------------------------------------------------------
# 11. Media engine (image/video generation callbacks)
# -----------------------------------------------------------------------------
MEDIA_ENGINE_PROVIDER=
MEDIA_ENGINE_WEBHOOK_URL=
MEDIA_ENGINE_WEBHOOK_SECRET=
MEDIA_ENGINE_ASSET_HOSTS=
CREATIVE_COST_IMAGE_USD=0
CREATIVE_COST_VIDEO_USD=0

# -----------------------------------------------------------------------------
# 12. Storage, rate limiting, email, SMS
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
REDIS_URL=
ZOOKA_MAIL_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# -----------------------------------------------------------------------------
# 13. Outbound agent webhooks
# -----------------------------------------------------------------------------
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_KEY=

# -----------------------------------------------------------------------------
# 14. Tests only
# -----------------------------------------------------------------------------
PLAYWRIGHT=0
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
CI_PLAYWRIGHT=0

# Optional LangSmith chat tracing. Off unless explicitly enabled.
# Enter the API key only in protected server environment settings, never chat.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=zooka-ai-chatbot
LANGSMITH_AGENT_ENVIRONMENT=development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Legacy LANGSMITHAPIKEE is read only as a fallback; prefer the documented key.
# Inputs, outputs, metadata and raw error content are hidden by the code.
