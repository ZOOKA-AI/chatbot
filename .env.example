# =============================================================================
# ZOOKA-AI — complete environment reference
# Covers every `process.env.*` read in lib/ app/ components/ (section 15 added 22 Nov 2026)
# plus the OAuth variables resolved dynamically by
# lib/integrations/oauth/config.ts (<PROVIDER>_CLIENT_ID / _CLIENT_SECRET).
#
# Rule: a feature is "integrated" only when its block below has real values.
# Copy to .env.local for development; set the same names in Vercel for
# Production (and Preview when you want preview builds to work like prod).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core runtime (required for the app to boot)
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployment, e.g. https://zooka-ai.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical auth URL (must match the domain people sign in on)
AUTH_URL=http://localhost:3000
# Custom domain used for workspace subdomains
PLATFORM_DOMAIN=zooka-ai.com
# NextAuth / auth.js signing secret (openssl rand -base64 32)
AUTH_SECRET=
# Legacy alias still read by some auth paths
NEXTAUTH_SECRET=
# Support inbox shown in the UI
NEXT_PUBLIC_SUPPORT_EMAIL=support@zooka-ai.com
# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# 2. Database (Supabase Postgres via Drizzle)
#    DATABASE_URL wins over POSTGRES_URL in lib/db/* and drizzle.config.ts.
#    Use the Transaction pooler for serverless: port 6543 + pgbouncer.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# One-off admin endpoints: /api/admin/migrate (x-migration-token), /api/admin/backup
MIGRATION_TOKEN=
BACKUP_TOKEN=
# Comma-separated list of admin emails
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# 3. Sign-in providers
# -----------------------------------------------------------------------------
# Google sign-in (console.cloud.google.com > Credentials)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Microsoft / Entra ID sign-in
MICROSOFT_LOGIN_CLIENT_ID=
MICROSOFT_LOGIN_CLIENT_SECRET=
# Facebook sign-in
FACEBOOK_LOGIN_CLIENT_ID=
FACEBOOK_LOGIN_CLIENT_SECRET=
# Phone / OTP sign-in
OTP_HASH_SECRET=

# -----------------------------------------------------------------------------
# 4. Google Workspace integrations (Drive / Gmail / Calendar)
#    Tokens are AES-256-GCM encrypted at rest with the key below.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# Shared envelope key for every stored integration credential
TOKEN_ENCRYPTION_KEY=
# Workspace secrets: generate a dedicated key with `openssl rand -base64 32`.
# Keep it stable and backed up; losing or changing it makes stored secrets unreadable.
WORKSPACE_SECRETS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 5. GitHub and Vercel integration (OAuth, names are built dynamically)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=
# Server-side Vercel API access for deploy/domain actions
VERCEL_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
# Injected automatically by Vercel at build time
VERCEL=1
VERCEL_URL=

# -----------------------------------------------------------------------------
# 6. WhatsApp Business Cloud API
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# 7. Meta / Instagram publishing
# -----------------------------------------------------------------------------
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 8. n8n automation bridge
# -----------------------------------------------------------------------------
N8N_WEBHOOK_SECRET=
# Growth Engine: n8n reads aggregate funnel counts from POST /api/integrations/n8n/growth/report.
# Separate from N8N_WEBHOOK_SECRET on purpose. Generate with: openssl rand -hex 32
N8N_GROWTH_REPORT_SECRET=
N8N_WHATSAPP_FORWARD_URL=

# -----------------------------------------------------------------------------
# 9. Stripe billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# -----------------------------------------------------------------------------
# 10. AI models and research
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-2.0-flash
AI_GATEWAY_API_KEY=
TAVILY_API_KEY=
# Base44 agent bridge
BASE44_AGENT_APP_ID=
BASE44_AGENT_API_KEY=
BASE44_AGENT_ALLOW_ALL=false
BASE44_API_BASE=https://app.base44.com/api
SOLAS_AGENT_KEY=

# -----------------------------------------------------------------------------
# 11. Media engine (image/video generation callbacks)
# -----------------------------------------------------------------------------
MEDIA_ENGINE_PROVIDER=
MEDIA_ENGINE_WEBHOOK_URL=
MEDIA_ENGINE_WEBHOOK_SECRET=
MEDIA_ENGINE_ASSET_HOSTS=
CREATIVE_COST_IMAGE_USD=0
CREATIVE_COST_VIDEO_USD=0

# -----------------------------------------------------------------------------
# 12. Storage, rate limiting, email, SMS
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
REDIS_URL=
ZOOKA_MAIL_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# -----------------------------------------------------------------------------
# 13. Outbound agent webhooks
# -----------------------------------------------------------------------------
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_KEY=

# -----------------------------------------------------------------------------
# 13b. Browser engine (the browser the agent and /workspace/browser drive)
# -----------------------------------------------------------------------------
# A Vercel function cannot launch Chromium, so a deployed environment needs a remote one.
# Resolution order in lib/browser/remote.ts: BROWSER_CDP_URL (any self-hosted Chromium, Steel,
# Hyperbrowser), then BROWSERLESS_TOKEN, then BROWSERBASE_API_KEY. With none of them the runtime
# reports "engine not provisioned" instead of pretending to work.
#
# BROWSERLESS_TOKEN is the one that matters for production: it is created in the Browserless
# dashboard and the engine targets the stealth endpoint (captcha solving on). BROWSERLESS_REGION
# defaults to production-sfo; the endpoint is wss://{region}.browserless.io/stealth.
BROWSER_CDP_URL=
BROWSERLESS_TOKEN=
BROWSERLESS_REGION=production-sfo
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# 14. Tests only
# -----------------------------------------------------------------------------
PLAYWRIGHT=0
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
CI_PLAYWRIGHT=0

# Optional LangSmith chat tracing. Off unless explicitly enabled.
# Enter the API key only in protected server environment settings, never chat.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=zooka-ai-chatbot
LANGSMITH_AGENT_ENVIRONMENT=development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Legacy LANGSMITHAPIKEE is read only as a fallback; prefer the documented key.
# Inputs, outputs, metadata and raw error content are hidden by the code.

# Owner testing access: accounts listed here get Business-plan features
# (including Agent mode) without a subscription. Usage is still metered.
# Comma-separated emails. Leave empty to turn it off.
OWNER_TESTING_EMAILS=

# Platform-admin security page (/workspace/security). Server-only JSON:
# {"measuredAt","rows":[{area,account,state,detail,measuredAt}],"actions":[...],"release":{...},"auditReportUrl"}
# Never commit real values; set it in Vercel as a sensitive Production variable.
SECURITY_POSTURE_JSON=

# -----------------------------------------------------------------------------
# 15. Variables read by the code that were missing from this file
#     (found in the 22 Nov 2026 audit). Defaults shown are the code defaults.
# -----------------------------------------------------------------------------
# Database roles: platform (RLS-aware), tenant runtime, and service/backup
DATABASE_URL_PLATFORM=
DATABASE_URL_TENANT=
DATABASE_URL_SERVICE=
# "on" enables row-level security enforcement in lib/db/platform-client.ts
TENANT_RLS_ENABLED=

# Auth and abuse controls
# "on" turns on email verification for new sign-ups
AUTH_EMAIL_VERIFICATION=
# "true" makes the BotID check blocking on /api/chat
BOTID_ENFORCE=
# "true" turns on the guest paywall in proxy.ts
GUEST_PAYWALL_ENABLED=

# Mail relay key rotation: the next key, accepted alongside ZOOKA_MAIL_KEY
ZOOKA_MAIL_KEY_NEXT=
# Public base URL used in email links (falls back to the app URL)
EMAIL_PUBLIC_BASE_URL=
# Digits of the support WhatsApp number used by /wa
SUPPORT_WHATSAPP_PHONE=

# Error monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Extra model provider
GROQ_API_KEY=

# Agent webhooks for Preview deployments (fall back to AGENT_WEBHOOK_URL/KEY)
AGENT_WEBHOOK_URL_PREVIEW=
AGENT_WEBHOOK_KEY_PREVIEW=

# Scheduler (/api/agents/scheduler)
SCHEDULER_TOKEN=
# Default tool: github_repo_inspect
SCHEDULER_TOOL=
# Defaults: 1 per org, 2 global, batch of 2
SCHEDULER_PER_ORG_LIMIT=
SCHEDULER_GLOBAL_LIMIT=
SCHEDULER_BATCH_SIZE=

# Background worker
WORKER_GITHUB_TOKEN=
# Comma-separated owner/repo list the worker may inspect
WORKER_GITHUB_ALLOWED_REPOS=
# "1" allows a platform-shared credential (off by default)
WORKER_ALLOW_SHARED_CREDENTIAL=

# n8n workflow scope filter
N8N_WORKFLOW_SCOPE=

# Growth analytics (GA4 + Search Console)
GOOGLE_GROWTH_SA_JSON=
GOOGLE_GROWTH_REDIRECT_URI=
GOOGLE_GROWTH_TOKEN_ENCRYPTION_KEY=
GA4_PROPERTY_ID=
# Default: sc-domain:zooka-ai.com
GSC_SITE=

# Social platform OAuth apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_STATE_SECRET=
TIKTOK_REDIRECT_BASE_URL=
X_CLIENT_ID=
X_CLIENT_SECRET=
# SNAPCHAT_* wins; SNAP_* is a legacy alias
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
RYZE_CLIENT_ID=

# Browser runtime tuning (defaults: headless, 20s nav, 10s action, 40 steps)
BROWSER_HEADLESS=
BROWSER_NAV_TIMEOUT_MS=
BROWSER_ACTION_TIMEOUT_MS=
BROWSER_MAX_STEPS=
BROWSER_EVIDENCE_DIR=

# Creative Studio (self-hosted media tools)
STUDIO_MEDIA_DIR=
STUDIO_QUOTA_BYTES=
STUDIO_FONT_FILE=
STUDIO_PYTHON=
STUDIO_SEGMENTATION_MODEL=
STUDIO_ALLOW_NONCOMMERCIAL_MODEL=
STUDIO_BG_TIMEOUT_MS=
STUDIO_FRAME_TIMEOUT_MS=
STUDIO_PIPER_VOICE=
STUDIO_TTS_TIMEOUT_MS=

# RunComfy media generation polling
RUNCOMFY_DEFAULT_VIDEO_SECONDS=
RUNCOMFY_POLL_INTERVAL_MS=
RUNCOMFY_POLL_BUDGET_MS=

# Engineer access scripts (scripts/admin). Values live in the owner's secret store, never here.
PLATFORM_ROLE_DATABASE_URL=
VERCEL_TEAM_ID=
GITHUB_REPO=
