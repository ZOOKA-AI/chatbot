# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
out/
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# turbo
.turbo

.env
.vercel
.env*.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/*
acceptance-rc/

# pnpm is the only package manager (packageManager: pnpm@9.12.3).
# A stray npm lockfile is a second source of dependency truth and makes
# npm ci / npm install fail with lock-sync errors inside the repo.
package-lock.json
npm-shrinkwrap.json

# TypeScript incremental build output: tracked by mistake, it changes on every build and
# turns unrelated pull requests into merge conflicts.
tsconfig.tsbuildinfo
*.tsbuildinfo
